PORT=5000
CORS_ORIGIN=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=myastroreader

JWT_SECRET=change_this_to_a_long_random_string
ADMIN_PASSWORD=change_this_admin_password

# Razorpay TEST MODE keys (from https://dashboard.razorpay.com/app/keys) -- required for
# booking payments and wallet top-ups to work. Leave as-is and payments will fail with a
# clear error until real test keys are added here.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
